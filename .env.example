# GEMINI_API_KEY: kunci untuk Gemini API. Wajib diisi untuk fitur Baca Otomatis dan penjelasan AI.
# Salin berkas ini menjadi .env, isi kunci kamu, dan jangan pernah di-commit ke GitHub.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: alamat tempat aplikasi berjalan (opsional untuk pemakaian lokal).
APP_URL="MY_APP_URL"
